+#
+# Streaming storage for huge sequences (avoids materializing the full sequence in RAM)
+#
+# Stores:
+# - the "parent" slice (seq_region) WITHOUT dna
+# - a set of component slices (ensembl_internal coordinate system) WITH dna, each <= _SUBSLICE_LENGTH
+# - assembly rows mapping parent -> components
+#
+sub cut_and_store_subslices_streaming {
+  my ($self, $slice_adaptor, $slice, $genome_file) = @_;
+
+  my $chunk_size = $self->param('_SUBSLICE_LENGTH');
+
+  # Ensure we have a coord system for internal chunks
+  my $internal_cs = Bio::EnsEMBL::CoordSystem->new(
+    -name           => 'ensembl_internal',
+    -rank           => 1,
+    -default        => 0,
+    -sequence_level => 1,
+  );
+
+  # Store internal coord system if not already present
+  my $coord_system_adaptor = $slice_adaptor->db->get_CoordSystemAdaptor;
+  my $existing = $coord_system_adaptor->fetch_by_name('ensembl_internal');
+  if (!$existing) {
+    $coord_system_adaptor->store($internal_cs);
+  } else {
+    $internal_cs = $existing;
+  }
+
+  # 1) Store the parent slice first (no dna)
+  $slice_adaptor->store($slice);
+  my $parent_seq_region_id = $slice_adaptor->get_seq_region_id($slice);
+
+  # 2) Stream sequence from the FASTA parser (record already positioned at correct header)
+  # Bio::EnsEMBL::IO::Parser::Fasta doesn't expose a streaming iterator for sequence lines,
+  # but it *does* keep raw sequence internally. To avoid holding the entire thing, we
+  # reconstruct it by reading the underlying filehandle from the current position.
+  #
+  # Implementation detail: We rely on the parser having an accessible filehandle in {fh}.
+  # If this changes in the IO module, this method must be updated.
+  my $fh = $genome_file->{fh};
+  $self->throw("Cannot access FASTA filehandle for streaming") unless $fh;
+
+  my $chunk = '';
+  my $chunk_index = 0;
+  my $written = 0;
+
+  while (my $line = <$fh>) {
+    # next record starts; stop streaming this one
+    if ($line =~ /^>/) {
+      # rewind one line so the outer loop can see the header
+      seek($fh, -length($line), 1);
+      last;
+    }
+    chomp $line;
+    next unless length $line;
+    $line =~ s/\s+//g;
+    $chunk .= $line;
+
+    while (length($chunk) >= $chunk_size) {
+      my $subseq = substr($chunk, 0, $chunk_size, '');
+      $subseq = uc($subseq);
+      $chunk_index++;
+      my $subseq_length = length($subseq);
+
+      my $subslice = Bio::EnsEMBL::Slice->new(
+        -coord_system       => $internal_cs,
+        -start              => 1,
+        -end                => $subseq_length,
+        -strand             => 1,
+        -seq_region_name    => $slice->seq_region_name . "_" . $chunk_index,
+        -seq_region_length  => $subseq_length,
+        -adaptor            => $slice_adaptor,
+      );
+
+      my $cmp_seq_region_id = $slice_adaptor->store($subslice, \$subseq);
+
+      my $asm_start = $written + 1;
+      my $asm_end   = $written + $subseq_length;
+      $written += $subseq_length;
+
+      my $sql = "INSERT INTO assembly(asm_seq_region_id, asm_start, asm_end, cmp_seq_region_id, cmp_start, cmp_end, ori) VALUES(?, ?, ?, ?, ?, ?, ?)";
+      my $sth = $slice_adaptor->dbc->prepare($sql);
+      $sth->execute($parent_seq_region_id, $asm_start, $asm_end, $cmp_seq_region_id, 1, $subseq_length, 1);
+    }
+  }
+
+  # flush remainder
+  if (length($chunk)) {
+    my $subseq = uc($chunk);
+    $chunk_index++;
+    my $subseq_length = length($subseq);
+
+    my $subslice = Bio::EnsEMBL::Slice->new(
+      -coord_system       => $internal_cs,
+      -start              => 1,
+      -end                => $subseq_length,
+      -strand             => 1,
+      -seq_region_name    => $slice->seq_region_name . "_" . $chunk_index,
+      -seq_region_length  => $subseq_length,
+      -adaptor            => $slice_adaptor,
+    );
+
+    my $cmp_seq_region_id = $slice_adaptor->store($subslice, \$subseq);
+    my $asm_start = $written + 1;
+    my $asm_end   = $written + $subseq_length;
+
+    my $sql = "INSERT INTO assembly(asm_seq_region_id, asm_start, asm_end, cmp_seq_region_id, cmp_start, cmp_end, ori) VALUES(?, ?, ?, ?, ?, ?, ?)";
+    my $sth = $slice_adaptor->dbc->prepare($sql);
+    $sth->execute($parent_seq_region_id, $asm_start, $asm_end, $cmp_seq_region_id, 1, $subseq_length, 1);
+  }
+}
+
 
